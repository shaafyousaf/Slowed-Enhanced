@page "/index.html"
@inherits IndexPage
@inject IJSRuntime JS
<link href="SoundPitchExtension.styles.css" rel="stylesheet" />

<div class="welcome">
    <div class="haze" aria-hidden="true"></div>

    <main class="hero">
        <div class="tag">V2 · MIT LICENSE</div>
        <h1 class="title">Slowed Enhanced</h1>
        <p class="subtitle">Your audio toolkit is ready</p>

        <div class="scope-wrap">
            <canvas class="scope" aria-hidden="true"
                    data-speed="0.8" data-vol="1.3" data-rev="0.4" data-pitch="1" data-legend="0"></canvas>
        </div>

        <p class="contribute">
            Know <strong>C# or JavaScript?</strong> This extension is now Open Source —
            fix a bug, add a feature, or just poke around. Next update will include your addition.
        </p>

        <div class="actions">
            <a class="btn primary" href="https://github.com/shaafyousaf/Slowed-Enhanced" target="_blank">View Source on GitHub</a>
            <a class="btn" href="https://github.com/shaafyousaf/Slowed-Enhanced/issues" target="_blank">Report a Bug</a>
        </div>
    </main>

    <footer class="foot">
        <a class="btn" href="https://shaafyousaf.me" target="_blank">made by Shaaf Yousaf</a>
    </footer>
</div>

<style>
    html, body { margin: 0; border: 0; background: #040405; }
</style>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender) await JS.InvokeVoidAsync("scope.start");
    }
}
