{
  "manifest_version": 3,
  "name": "Slowed Enhanced",
  "description": "Modifies your sound and pitch according to your settings. Open Source. MIT License. (Find me at shaafyousaf.com)",
  "version": "2.0.0",
  "permissions": [ "scripting", "activeTab", "storage" ],
  "background": {
    "service_worker": "content/BackgroundWorker.js",
    "type": "module"
  },
  "icons": {
    "16": "/icons/16.png",
    "32": "/icons/32.png",
    "48": "/icons/48.png",
    "128": "/icons/128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [ "stretch-worklet.js", "framework/*", "content/*" ],
      "matches": [ "<all_urls>" ]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}